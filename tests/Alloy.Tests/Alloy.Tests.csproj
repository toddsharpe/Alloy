<Project Sdk="Microsoft.NET.Sdk">

	<!-- Host tests: hardware-free image code compiled against the real BCL -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
	</ItemGroup>

	<!-- System.IO stays out of the implicit usings: the ABI has its own FileAccess, and the SDK its own File and Directory -->
	<ItemGroup>
		<Using Include="Xunit" />
		<Using Remove="System.IO" />
	</ItemGroup>

	<!-- The same files the images compile -->
	<ItemGroup>
		<Compile Include="..\..\src\CoreLib\Alloy\**\*.cs" Link="Shared\CoreLib\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\..\src\Abi\**\*.cs" Link="Shared\Abi\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\..\src\Arch\x64\Paging.cs" Link="Shared\Arch\Paging.cs" />
		<Compile Include="..\..\src\Kernel\Mm\BitmapAllocator.cs" Link="Shared\Kernel\BitmapAllocator.cs" />
		<Compile Include="..\..\src\Kernel\Io\BlockDevice.cs" Link="Shared\Kernel\Io\BlockDevice.cs" />
		<Compile Include="..\..\src\Kernel\Io\Crc32.cs" Link="Shared\Kernel\Io\Crc32.cs" />
		<Compile Include="..\..\src\Kernel\Io\Gpt.cs" Link="Shared\Kernel\Io\Gpt.cs" />
		<Compile Include="..\..\src\Kernel\Io\SectorCache.cs" Link="Shared\Kernel\Io\SectorCache.cs" />
		<Compile Include="..\..\src\Kernel\Io\FileSystem.cs" Link="Shared\Kernel\Io\FileSystem.cs" />
		<Compile Include="..\..\src\Kernel\Io\Fat32.cs" Link="Shared\Kernel\Io\Fat32.cs" />
		<Compile Include="..\..\src\Kernel\Io\Paths.cs" Link="Shared\Kernel\Io\Paths.cs" />
		<Compile Include="..\..\src\Kernel\Ke\Calendar.cs" Link="Shared\Kernel\Ke\Calendar.cs" />
		<Compile Include="..\..\tools\BuildImage\SymbolWriter.cs" Link="Shared\Tools\SymbolWriter.cs" />
		<Compile Include="..\..\src\Apps\Alloy.Sdk\Web\Html\*.cs" Link="Shared\Sdk\Web\Html\%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
