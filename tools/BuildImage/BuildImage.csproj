<Project Sdk="Microsoft.NET.Sdk">

	<!-- Host tool: writes the kernel's symbol table and builds the boot VHDX (no admin, no diskpart) -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="LTRData.DiscUtils.Vhdx" Version="1.0.90" />
		<PackageReference Include="LTRData.DiscUtils.Fat" Version="1.0.90" />
	</ItemGroup>

	<!-- The on-disk formats are defined once, in the image sources -->
	<ItemGroup>
		<Compile Include="..\..\src\Abi\SymbolTable.cs" Link="Abi\SymbolTable.cs" />
	</ItemGroup>

</Project>
